#: kfritz.desktop:2
msgctxt "Name"
msgid "KFritz"
msgstr "के-फ्रिट्झ"

#: kfritz.desktop:6
msgctxt "GenericName"
msgid "Call notificator"
msgstr "कॉल सूचना देणारा"

#: kfritz.desktop:7
msgctxt "Comment"
msgid ""
"Access call history and phone book of your Fritz!Box and get notifications "
"on incoming and outgoing calls."
msgstr ""
"तुमच्या फ्रिट्झबोक्सच्या कॉलचा इतिहास व फोन पुस्तक बघा व आत येणाऱ्या व बाहेर जाणाऱ्या "
"कॉल्सची सूचना मिळवा."

#: kfritz.notifyrc:5
msgctxt "Name"
msgid "Incoming Call"
msgstr "आत येणारा कॉल"

#: kfritz.notifyrc:10
msgctxt "Name"
msgid "Outgoing Call"
msgstr "बाहेर जाणारा कॉल"

#: kfritz.notifyrc:15
msgctxt "Name"
msgid "Call got connected"
msgstr "जुळलेला कॉल"

#: kfritz.notifyrc:19
msgctxt "Name"
msgid "Call got disconnected"
msgstr "न जुळलेला कॉल"
