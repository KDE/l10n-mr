#: plasmapkg.cpp:252
#, kde-format
msgid "Could not find a suitable installer for package of type %1"
msgstr "%1 या पॅकेज प्रकारासाठी योग्य प्रतिष्ठापना कार्यक्रम सापडला नाही"

#: plasmapkg.cpp:263
#, kde-format
msgid "Could not load installer for package of type %1. Error reported was: %2"
msgstr ""
"%1 या पॅकेज प्रकारासाठी प्रतिष्ठापना कार्यक्रम लोड होऊ शकला नाही. ही त्रुटी "
"होती : %2"

#: plasmapkg.cpp:273
#, kde-format
msgid "Listing service types: %1"
msgstr "सेवा प्रकारांची यादी करत आहे : %1"

#: plasmapkg.cpp:333
#, kde-format
#| msgid "Plugin %1 is not installed."
msgid "Error: Plugin %1 is not installed."
msgstr "त्रुटी : %1 हे प्लगइन प्रतिष्ठापीत झालेले नाही."

#: plasmapkg.cpp:343
msgctxt ""
"No option was given, this is the error message telling the user he needs at "
"least one, do not translate install, remove, upgrade nor list"
msgid "One of install, remove, upgrade or list is required."
msgstr "प्रतिष्ठापन, काढून टाका, अद्ययावत करा किंवा यादी यापैकी एकाची गरज आहे."

#: plasmapkg.cpp:422
#, kde-format
msgid "Error: Can't find plugin metadata: %1"
msgstr "त्रुटी :  प्लगइन मेटाडेटा सापडत नाही: %1"

#: plasmapkg.cpp:425
#, kde-format
msgid "Showing info for package: %1"
msgstr "पॅकेजची माहिती दर्शवित आहे : %1"

#: plasmapkg.cpp:426
#, kde-format
msgid "      Name : %1"
msgstr "      नाव : %1"

#: plasmapkg.cpp:427
#, kde-format
msgid "   Comment : %1"
msgstr "   टीप : %1"

#: plasmapkg.cpp:428
#, kde-format
msgid "    Plugin : %1"
msgstr "    प्लगइन : %1"

#: plasmapkg.cpp:429
#, kde-format
msgid "    Author : %1"
msgstr "    लेखक : %1"

#: plasmapkg.cpp:430
#, kde-format
msgid "      Path : %1"
msgstr "      मार्ग : %1"

#: plasmapkg.cpp:439
msgctxt ""
"The user entered conflicting options packageroot and global, this is the "
"error message telling the user he can use only one"
msgid ""
"The packageroot and global options conflict each other, please select only "
"one."
msgstr "पॅकेजरूट व जागतिक पर्याय यांचा मतभेद आहे. कृपया फक्त एक निवडा."

