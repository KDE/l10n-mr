#: fileprops.cpp:230
msgid "kfile"
msgstr "kfile"

#: fileprops.cpp:231
msgid "A command-line tool to read and modify metadata of files."
msgstr "फाइलचा मेटाडेटा वाचण्याकरीता व संपादन करण्याकरीता आदेश-ओळ साधन."

#: fileprops.cpp:232
msgid "(c) 2002, Carsten Pfeiffer"
msgstr "(c) 2002, Carsten Pfeiffer"

#: fileprops.cpp:236
msgid "Carsten Pfeiffer"
msgstr "Carsten Pfeiffer"

#: fileprops.cpp:245
msgid "Do not print the mimetype of the given file(s)"
msgstr "प्रविष्ट फाइलचे mime प्रकार छपाईकृत करू नका"

#: fileprops.cpp:247
msgid "List all supported metadata keys."
msgstr "सर्व समर्थीत मेटाडेटा कि यादी नुरूप दर्शवा."

#: fileprops.cpp:249
msgid "List all metadata keys which have a value in the given file(s)."
msgstr ""

#: fileprops.cpp:252
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr ""

#: fileprops.cpp:255
msgid "Prints all metadata values, available in the given file(s)."
msgstr "सर्व मेटाडेटा मुल्य छपाईकृत करतो, प्रविष्ट फाइल अंतर्गत उपलब्ध."

#: fileprops.cpp:257
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr ""

#: fileprops.cpp:259
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr ""

#: fileprops.cpp:261
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr ""

#: fileprops.cpp:263
msgid "The file (or a number of files) to operate on."
msgstr "कार्य करण्याजोगी फाइल (किंवा फाइलची संख्या)."

#: fileprops.cpp:277
msgid "No files specified"
msgstr "फाइल निर्देशीत केले नाही"

#: fileprops.cpp:297
msgid "Cannot determine metadata"
msgstr "मेटाडेटा ओळखू शकले नाही"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "संदिप शेडमाके"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "sandeep.shedmake@gmail.com"

