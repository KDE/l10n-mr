msgstr "URL किंवा URLs"

#: kioclient.cpp:119 kioclient.cpp:122
msgid "Source URL or URLs"
msgstr "स्त्रोत URL किंवा URLs"

#: kioclient.cpp:120 kioclient.cpp:123
msgid "Destination URL"
msgstr "लक्ष्य URL"

