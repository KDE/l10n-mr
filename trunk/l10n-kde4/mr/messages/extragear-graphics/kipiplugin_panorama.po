#: importwizard/optimizepage.cpp:331 importwizard/preprocessingpage.cpp:242
msgctxt "@title:window"
msgid "Pre-Processing Messages"
msgstr ""

#: importwizard/optimizepage.cpp:340
#, kde-format
msgid ""
"<qt><p><h1><b>Images Pre-Processing is Done</b></h1></p><p>The optimization "
"step according to your settings is ready to be performed.</p><p>This step "
"can include an automatic leveling of the horizon, and also an automatic "
"projection selection and size</p><p>To perform this operation, the <command>"
"%1</command> program from the <a href='%2'>%3</a> project will be used.</"
"p><p>Press the \"Next\" button to run the optimization.</p></qt>"
msgstr ""

#: importwizard/preprocessingpage.cpp:106
msgctxt "@title:window"
msgid "<b>Pre-Processing Images</b>"
msgstr ""

#: importwizard/preprocessingpage.cpp:119
msgctxt "@option:check"
msgid "Detect moving skies"
msgstr ""

#: importwizard/preprocessingpage.cpp:121
msgctxt "@info:tooltip"
msgid ""
"Automatic detection of clouds to prevent wrong keypoints matching between "
"images due to moving clouds."
msgstr ""

#: importwizard/preprocessingpage.cpp:123
msgctxt "@info:whatsthis"
msgid ""
"<b>Detect moving skies</b>: During the control points selection and "
"matching, this option discards any points that are associated to a possible "
"cloud. This is useful to prevent moving clouds from altering the control "
"points matching process."
msgstr ""

#: importwizard/preprocessingpage.cpp:170
msgid ""
"<qt><p>Pre-processing is in progress, please wait.</p><p>This can take a "
"while...</p></qt>"
msgstr ""

#: importwizard/preprocessingpage.cpp:279
msgid ""
"<qt><p>Pre-processing has failed.</p><p>Press \"Details\" to show processing "
"messages.</p></qt>"
msgstr ""

#: importwizard/preprocessingpage.cpp:341
#, kde-format
msgid ""
"<qt><p>Now, we will pre-process images before stitching them.</p><p>Pre-"
"processing operations include Raw demosaicing. Raw images will be converted "
"to 16-bit sRGB images with auto-gamma.</p><p>Pre-processing also include a "
"calculation of some control points to match overlaps between images. For "
"that purpose, the <b>%1</b> program from the <a href='%2'>%3</a> project "
"will be used.</p><p>Press \"Next\" to start pre-processing.</p></qt>"
msgstr ""

