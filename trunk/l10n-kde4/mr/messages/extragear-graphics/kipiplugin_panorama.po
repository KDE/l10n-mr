msgid "Details..."
msgstr "तपशील..."

#: importwizard/optimizepage.cpp:188
msgid ""
"<qt><p>Optimization is in progress, please wait.</p><p>This can take a "
"while...</p></qt>"
msgstr ""

#: importwizard/optimizepage.cpp:277
