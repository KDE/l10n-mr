#: utils/plasma-runner-installer/plasma-runner-installer.desktop:2
msgctxt "Name"
msgid "Installer"
msgstr "प्रतिष्ठापक"

#: utils/plasma-runner-installer/plasma-runner-installer.desktop:47
msgctxt "Comment"
msgid "Suggests the installation of not-installed applications"
msgstr "प्रतिष्ठापीत नसलेल्या अनुप्रयोगांची प्रतिष्ठापना सुचवितो"

#: utils/qapt-deb-installer/qapt-deb-installer.desktop:2
msgctxt "Name"
msgid "QApt Package Installer"
msgstr "क्यू-एप्ट पॅकेज प्रतिष्ठापक"

#: utils/qapt-deb-installer/qapt-deb-installer.desktop:46
msgctxt "GenericName"
msgid "Package Installer"
msgstr "पॅकेज प्रतिष्ठापक"

#: utils/qapt-deb-installer/qapt-deb-installer.desktop:90
msgctxt "Comment"
msgid "Install and view software packages"
msgstr "सॉफ़्टवेअर पॅकेजेस प्रतिष्ठापीत व प्रदर्शित करा"

#: utils/qapt-deb-thumbnailer/debthumbnailer.desktop:3
msgctxt "Name"
msgid "Debian Package Files"
msgstr "डेबियन पॅकेज फाईल्स"

#~ msgctxt "Name"
#~ msgid "Kubuntu"
#~ msgstr "कुबुन्टु"

#~ msgctxt "Name"
#~ msgid "Update package information"
#~ msgstr "पॅकेज माहिती अद्ययावत करा"

#~ msgctxt "Description"
#~ msgid "To update the software catalog you need to authenticate."
#~ msgstr "सॉफ़्टवेअर सूची अद्ययावत करण्याकरीता तुमची परवानगी घेण्याची गरज आहे."

#~ msgctxt "Name"
#~ msgid "Install or remove packages"
#~ msgstr "पॅकेजेस प्रतिष्ठापीत करा किंवा काढून टाका"

#~ msgctxt "Description"
#~ msgid "To install or remove software you need to authenticate."
#~ msgstr ""
#~ "सॉफ़्टवेअर प्रतिष्ठापीत करण्याकरीता किंवा काढण्याकरिता तुमची परवानगी घेण्याची गरज आहे."

#~ msgctxt "Name"
#~ msgid "Change software configuration"
#~ msgstr "सॉफ़्टवेअर संयोजना बदला"

#~ msgctxt "Description"
#~ msgid "To change software settings you need to authenticate."
#~ msgstr "सॉफ़्टवेअर संयोजना बदलण्याकरिता तुमची परवानगी घेण्याची गरज आहे."

#~ msgctxt "Name"
#~ msgid "Cancel the task of another user"
#~ msgstr "दुसऱ्या वापरकर्त्याचे कार्य रद्द करा"

#~ msgctxt "Description"
#~ msgid "To cancel someone else's software changes you need to authenticate."
#~ msgstr ""
#~ "दुसऱ्या वापरकर्त्याचे कार्य रद्द करण्याकरीता किंवा काढण्याकरिता तुमची परवानगी घेण्याची "
#~ "गरज आहे."
