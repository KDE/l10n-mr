msgstr "(C) 2000-2003, Hans Petter Bieker"

#: main.cpp:64
msgid "Hans Petter Bieker"
msgstr "Hans Petter Bieker"

#: main.cpp:70
msgid "The signal number that was caught"
msgstr "संकेत क्रमांक जे प्राप्त केले गेले"

