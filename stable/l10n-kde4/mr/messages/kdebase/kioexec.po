#: main.cpp:44
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KIO Exec - दूरस्थ फाइल उघडले, संपादन पहातो, अपलोड करीता विचारतो"

#: main.cpp:52
msgid "'command' expected.\n"
msgstr "'आदेश' अपेक्षीत.\n"

#: main.cpp:81
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"सदोषीत आहे"

#: main.cpp:83
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"दूरस्थ URL %1\n"
"--tempfiles स्विच सह वापरू शकत नाही"

#: main.cpp:216
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"तात्पुरर्ते फाइल\n"
"%1\n"
"संपादीत केले गेले आहे.\n"
"तुम्हाला तरी त्यास नष्ट करायचे?"

#: main.cpp:217 main.cpp:224
msgid "File Changed"
msgstr "फाइल बदलविले"

#: main.cpp:217
msgid "Do Not Delete"
msgstr "नष्ट करू नका"

#: main.cpp:223
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"फाइल\n"
"%1\n"
"संपादीत केले गेली आहे.\n"
"तुम्हाला बदलाव अपलोड करायचे?"

#: main.cpp:224
msgid "Upload"
msgstr "अपलोड"

#: main.cpp:224
msgid "Do Not Upload"
msgstr "अपलोड करू नका"

