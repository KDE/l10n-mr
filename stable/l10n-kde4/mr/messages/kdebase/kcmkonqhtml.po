msgstr "स्टाइलशीट"

#: appearance.cpp:65
msgid "Images"
msgstr "प्रतिमा"

#: appearance.cpp:70
msgid "A&utomatically load images"
msgstr "आपोआप प्रतिमा दाखल करा (&u)"

#: appearance.cpp:71
msgid ""
"<html>If this box is checked, Konqueror will automatically load any images "
"that are embedded in a web page. Otherwise, it will display placeholders for "
"the images, and you can then manually load the images by clicking on the "
"image button.<br />Unless you have a very slow network connection, you will "
"probably want to check this box to enhance your browsing experience.</html>"
msgstr ""

#: appearance.cpp:81
msgid "Dra&w frame around not completely loaded images"
msgstr "पूर्णतया दाखल न केलेले प्रतिमा भोवती फ्रेम रेखांकीत करा (&w)"

#: appearance.cpp:82
msgid ""
"<html>If this box is checked, Konqueror will draw a frame as a placeholder "
"around images embedded in a web page that are not yet fully loaded.<br />You "
"will probably want to check this box to enhance your browsing experience, "
"especially if have a slow network connection.</html>"
msgstr ""

#: appearance.cpp:93
msgctxt "animations"
msgid "Enabled"
msgstr "कार्यान्वीत"

#: appearance.cpp:94
msgctxt "animations"
msgid "Disabled"
msgstr "अकार्यान्वीत"

#: appearance.cpp:95
msgid "Show Only Once"
msgstr "फक्त एकदा दर्शवा"

#: appearance.cpp:96
msgid ""
"<html>Controls how Konqueror shows animated images:<br /><ul><li><b>Enabled</"
"b>: Show all animations completely.</li><li><b>Disabled</b>: Never show "
"animations, show the starting image only.</li><li><b>Show only once</b>: "
"Show all animations completely but do not repeat them.</li></ul></html>"
msgstr ""

#: appearance.cpp:101
msgid "A&nimations:"
msgstr "ऍनीमेशन (&n):"

#: appearance.cpp:106 htmlopts.cpp:124
msgctxt "@title:group"
msgid "Miscellaneous"
msgstr "संकीर्ण"

#: appearance.cpp:111
msgctxt "underline"
msgid "Enabled"
msgstr "कार्यान्वीत"

#: appearance.cpp:112
msgctxt "underline"
msgid "Disabled"
msgstr "अकार्यान्वीत"

#: appearance.cpp:113
msgid "Only on Hover"
msgstr ""

#: appearance.cpp:114
msgid "Und&erline links:"
msgstr "लिंक अधोरेखीत करा (&e):"

#: appearance.cpp:117
msgid ""
"<html>Controls how Konqueror handles underlining hyperlinks:<br /"
"><ul><li><b>Enabled</b>: Always underline links</li><li><b>Disabled</b>: "
"Never underline links</li><li><b>Only on Hover</b>: Underline when the mouse "
"is moved over the link</li></ul><br /><i>Note: The site's CSS definitions "
"can override this value.</i></html>"
msgstr ""

#: appearance.cpp:127
msgid "When Efficient"
msgstr ""

#: appearance.cpp:128
msgctxt "smooth scrolling"
msgid "Always"
msgstr "नेहमी"

#: appearance.cpp:129
msgctxt "soft scrolling"
msgid "Never"
msgstr "कधिच नाही"

#: appearance.cpp:130
msgid "S&mooth scrolling:"
msgstr ""

#: appearance.cpp:132
msgid ""
"<html>Determines whether Konqueror should use smooth steps to scroll HTML "
"pages, or whole steps:<br /><ul><li><b>Always</b>: Always use smooth steps "
"when scrolling.</li><li><b>Never</b>: Never use smooth scrolling, scroll "
"with whole steps instead.</li><li><b>When Efficient</b>: Only use smooth "
"scrolling on pages where it can be achieved with moderate usage of system "
"resources.</li></ul></html>"
msgstr ""

#: appearance.cpp:145
msgid ""
"<h1>Konqueror Fonts</h1>On this page, you can configure which fonts "
"Konqueror should use to display the web pages you view."
msgstr ""

#: appearance.cpp:157
msgid "Font Si&ze"
msgstr "फॉन्ट आकार (&z)"

#: appearance.cpp:160 appearance.cpp:176
msgid "This is the relative font size Konqueror uses to display web sites."
msgstr "हे Konqueror द्वारे वेब स्थळ दर्शविण्याकरीता वापरण्याजोगी संबंधित फॉन्ट आकार आहे."

#: appearance.cpp:163
msgid "M&inimum font size:"
msgstr "किमान (&i) फॉन्ट आकर:"

#: appearance.cpp:167
msgid ""
"Konqueror will never display text smaller than this size,<br />overriding "
"any other settings."
msgstr ""
"Konqueror कधिही या आकारपेक्षा कमी आकाराचे पाठ्य दर्शविणार नाही,<br />इतर संयोजना "
"खोडून पुन्हा लिहीत आहे."

#: appearance.cpp:171
msgid "&Medium font size:"
msgstr "मध्यम फॉन्ट आकार (&M):"

#: appearance.cpp:186
msgid "S&tandard font:"
msgstr "मानक फॉन्ट (&t):"

#: appearance.cpp:187
msgid "This is the font used to display normal text in a web page."
msgstr "या फॉन्टचा वापर वेब पान अंतर्गत सर्वसाधारण पाठ्य दर्शविण्याकरीता केला जातो."

#: appearance.cpp:192
msgid "&Fixed font:"
msgstr "ठराविक रूंदीचे फॉन्ट (&F):"

#: appearance.cpp:193
msgid ""
"This is the font used to display fixed-width (i.e. non-proportional) text."
msgstr ""
"या फॉन्टचा वापर ठराविक-रूंदीचे (उ.दा non-proportional) पाठ्य दर्शविण्याकरीता केला "
"जातो."

#: appearance.cpp:198
msgid "S&erif font:"
msgstr "सेरीफ फॉन्ट (&e):"

#: appearance.cpp:199
msgid "This is the font used to display text that is marked up as serif."
msgstr "या फॉन्टचा वापर सेरीफ चिन्हाकृत केलेले पाठ्य दर्शविण्याकरीता केला जातो."

#: appearance.cpp:205
msgid "Sa&ns serif font:"
msgstr "सॅन्स् सेरीफ फॉन्ट (&n):"

#: appearance.cpp:206
msgid "This is the font used to display text that is marked up as sans-serif."
msgstr "या फॉन्टचा वापर सॅन्स्-सेरीफ चिन्हाकृत केलेले पाठ्य दर्शविण्याकरीता केला जातो."

#: appearance.cpp:211
msgid "C&ursive font:"
msgstr ""

#: appearance.cpp:212
msgid "This is the font used to display text that is marked up as italic."
msgstr "या फॉन्टचा वापर तिरपे चिन्हाकृत केलेले पाठ्य दर्शविण्याकरीता केला जातो."

#: appearance.cpp:217
msgid "Fantas&y font:"
msgstr ""

#: appearance.cpp:218
msgid ""
"This is the font used to display text that is marked up as a fantasy font."
msgstr ""

#: appearance.cpp:232
msgid "Font &size adjustment for this encoding:"
msgstr "या एनकोडींग करीता सुस्थीत करण्याजोगी फॉन्ट आकार (&s):"

#: appearance.cpp:243 appearance.cpp:443
msgid "Use Language Encoding"
msgstr "भाषा एनकोडींगचा वापर करा"

#: appearance.cpp:245
msgid "Default encoding:"
msgstr "मुलभूत एनकोडींग:"

#: appearance.cpp:247
msgid ""
"Select the default encoding to be used; normally, you will be fine with 'Use "
"language encoding' and should not have to change this."
