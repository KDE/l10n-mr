#: krdb.cpp:350
#, kde-format
msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance & Themes -> Colors in the Control Center and disable the "
"checkbox\n"
"# \"Apply colors to non-KDE applications\"\n"
"#\n"
"#\n"
msgstr ""
"# KDE द्वारे निर्मीत, %1\n"
"#\n"
"# KDE ने आपली GTK संयोजना खोडून पुन्हा न लिहायचे असल्यास,\n"
"# नियंत्रण केंद्रातील दृश्य & सुत्रयोजना -> रंग निवडा व निवडपेटी बंद करा\n"
"# \"विना-KDE अनुप्रयोगांकरीता रंग लागू करा\"\n"
"#\n"
"#\n"
