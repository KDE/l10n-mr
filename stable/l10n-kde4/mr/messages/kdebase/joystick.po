#: caldialog.cpp:98
#, kde-format
msgid ""
"<qt>Calibration is about to check the value range your device delivers.<br /"
"><br />Please move <b>axis %1 %2</b> on your device to the <b>minimum</b> "
"position.<br /><br />Press any button on the device or click on the 'Next' "
"button to continue with the next step.</qt>"
msgstr ""
"<qt>कॅलिब्रेशन तुमच्या साधन द्वारे पूरवले जाणाऱ्या मूल्य क्षेत्राची तपासणी करणार आहे.<br /"
"><br />कृपया <b>अक्ष %1 %2</b> यांस तुमच्या साधन वरील <b>किमान</b> ठिकाणी "
"स्थानांतरीत करा.<br /><br />कृपया साधन वरील कुठलिही बटण दाबा किंवा पुढे जाण्याकरीता "
"'पुढे' बटणावर क्लिक करा.</qt>"

