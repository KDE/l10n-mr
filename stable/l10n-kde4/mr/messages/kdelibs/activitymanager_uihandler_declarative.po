msgstr "गुप्तशब्द दाखल करा"

#: package/contents/ui/uihandler.qml:84
msgid "Verify:"
msgstr "तपासणी :"

#: package/contents/ui/uihandler.qml:85
msgid "Password strength meter:"
msgstr "पासवर्ड सामर्थ्य मीटर :"

#: package/contents/ui/uihandler.qml:86
